# Copy this file to .env and fill in real values before running.

# Required
# MODEL=gpt-5.4
# PROVIDER=openai
# MODEL_PROVIDER=openai
# MODEL_PLATFORM=openai
# MODEL_API_KEY=sk-proj-REPLACE_ME

# Optional
# OpenRouter example:
PROVIDER=openrouter
MODEL_PROVIDER=openrouter
MODEL_PLATFORM=alibaba
MODEL=qwen/qwen3.6-plus
MODEL_API_KEY=''
MODEL_API_URL=https://openrouter.ai/api/v1

MAX_STEPS=100
IMAGE=toolathlon-pack:latest
